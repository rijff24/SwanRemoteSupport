+fn destination_for_socket(local: SocketAddr, destination: SocketAddr) -> SocketAddr {
+    match (local, destination) {
+        // Winsock rejects an AF_INET sockaddr on an AF_INET6 socket with
+        // WSAEFAULT (10014), even when IPV6_V6ONLY is disabled.
+        (SocketAddr::V6(_), SocketAddr::V4(address)) => SocketAddr::V6(
+            std::net::SocketAddrV6::new(address.ip().to_ipv6_mapped(), address.port(), 0, 0),
+        ),
+        (_, destination) => destination,
+    }
 }
 
